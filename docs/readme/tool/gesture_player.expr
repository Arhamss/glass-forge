(() { const base = 600; final strokes = <List<List<double>>>[ /*STROKES*/ ]; final sw = Stopwatch()..start(); final st = List<int>.filled(strokes.length, 0); final last = List<Offset>.filled(strokes.length, Offset.zero); final b = WidgetsBinding.instance; Offset at(List<List<double>> s, double t) { for (var i = 1; i < s.length; i++) { if (t <= s[i][0]) { final a = s[i - 1], c = s[i]; final f = c[0] == a[0] ? 1.0 : ((t - a[0]) / (c[0] - a[0])).clamp(0.0, 1.0); final k = c[3] == 1 ? f * f * (3 - 2 * f) : f; return Offset(a[1] + (c[1] - a[1]) * k, a[2] + (c[2] - a[2]) * k); } } return Offset(s.last[1], s.last[2]); } Timer.periodic(const Duration(milliseconds: 8), (tm) { final t = sw.elapsedMicroseconds / 1000.0; final ts = Duration(microseconds: sw.elapsedMicroseconds); var done = true; for (var j = 0; j < strokes.length; j++) { final s = strokes[j]; final id = base + j; if (st[j] == 0) { done = false; if (t >= s.first[0]) { st[j] = 1; last[j] = Offset(s.first[1], s.first[2]); b.handlePointerEvent(PointerDownEvent(pointer: id, timeStamp: ts, position: last[j])); } } else if (st[j] == 1) { done = false; if (t >= s.last[0]) { st[j] = 2; b.handlePointerEvent(PointerUpEvent(pointer: id, timeStamp: ts, position: last[j])); } else { final p = at(s, t); b.handlePointerEvent(PointerMoveEvent(pointer: id, timeStamp: ts, position: p, delta: p - last[j])); last[j] = p; } } } if (done) tm.cancel(); }); return 'playing'; })()
