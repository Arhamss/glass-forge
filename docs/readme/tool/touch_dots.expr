(() { final dots = ValueNotifier<Map<int, Offset>>(<int, Offset>{}); WidgetsBinding.instance.pointerRouter.addGlobalRoute((e) { final m = Map<int, Offset>.of(dots.value); if (e is PointerDownEvent || e is PointerMoveEvent) { m[e.pointer] = e.position; } else if (e is PointerUpEvent || e is PointerCancelEvent) { m.remove(e.pointer); } else { return; } dots.value = m; }); NavigatorState? nav; void visit(Element el) { if (el is StatefulElement && el.state is NavigatorState) { nav ??= el.state as NavigatorState; } if (nav == null) el.visitChildren(visit); } WidgetsBinding.instance.rootElement!.visitChildren(visit); nav!.overlay!.insert(OverlayEntry(builder: (_) => IgnorePointer(child: ValueListenableBuilder<Map<int, Offset>>(valueListenable: dots, builder: (_, m, __) => Stack(children: [for (final p in m.values) Positioned(left: p.dx - 22, top: p.dy - 22, child: Container(width: 44, height: 44, decoration: BoxDecoration(shape: BoxShape.circle, color: const Color(0x55FFFFFF), border: Border.all(color: const Color(0xAAFFFFFF), width: 2), boxShadow: const [BoxShadow(color: Color(0x40000000), blurRadius: 8)])))]))))); return 'dots on'; })()
